# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins. Leave unset to allow all (dev only).
CORS_ORIGIN=http://localhost:3000

# Signs session tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-before-you-deploy-anything

# SQLite file. Defaults to backend/database/investwise.db — no server to install.
DATABASE_FILE=database/investwise.db

# ── Claude (the Copilot and the written autopsy report) ─────────────────
# https://console.anthropic.com/settings/keys
# Without this the app still runs: the Copilot answers from its offline brain
# and every such reply is labelled "offline" in the transcript.
CLAUDE_API_KEY=

# Defaults to claude-opus-5 when unset.
CLAUDE_MODEL=claude-opus-5

# ── Market data ─────────────────────────────────────────────────────────
# Finnhub is the primary source. Free tier is 60 calls/minute, and quotes are
# cached for 5 minutes, so a live demo uses only a handful of calls.
# https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Optional second source, tried when Finnhub fails. Free tier is 5 calls/minute.
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# With neither key set, prices come from database/mockData.json (54 NSE
# instruments) and the UI badge reads "Offline dataset" rather than "Live".
