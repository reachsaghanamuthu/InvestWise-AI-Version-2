# Base URL of the InvestWise backend.
# Leave as-is for local development — Vite proxies /api to VITE_API_PROXY_TARGET.
VITE_API_URL=/api

# Where the dev server proxies /api during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:4000

# "true" skips the network entirely and runs the app on its bundled dataset.
# Useful for a guaranteed-offline demo. The app also falls back automatically
# whenever the backend is unreachable.
VITE_DEMO_MODE=false
